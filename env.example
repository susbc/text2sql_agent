# SQLite 配置（应用存储：历史/元数据 + 业务数据，单文件嵌入式库，无需数据库服务）
# 首次连接自动幂等建表并加载 data/seed_business.sql / data/seed_history.sql 种子
SQLITE_PATH=data/text2sql.db

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j@123
NEO4J_DATABASE=neo4j

# Neon PostgreSQL 集成测试（可选）
NEON_DB_URL=

# 真实数据库集成测试开关：设置为 1 后 pytest 才会连接真实 Neo4j
# （SQLite 集成测试用临时文件库，无需开关）
TEXT2SQL_RUN_DB_TESTS=0

# LLM 配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=

# 检索配置
RETRIEVAL_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
BM25_WEIGHT=0.6
DENSE_WEIGHT=0.4
FAISS_ENABLED=true
FAISS_EMBEDDING_DIM=1024
FAISS_INDEX_TYPE=flat

# 知识库索引磁盘缓存（默认关闭，避免图谱覆盖导入后读到旧索引）
INDEX_CACHE_ENABLED=false
INDEX_CACHE_DIR=data/index_cache

# SQL 配置
# 默认生成方言 sqlite（执行目标为 SQLite 配置库）；启用语义治理时仅支持 mysql
SQL_DIALECT=sqlite
SQL_MAX_LENGTH=2000
SQL_QUERY_MAX_ROWS=500
SQL_QUERY_TIMEOUT_MS=10000
SQL_SCOPE_ENFORCEMENT=true
SQL_BLOCKED_TABLES=knowledge_metadata,table_schema,column_schema,sql_generation_history,retrieval_terms,user_feedback
PROMPT_MAX_LENGTH=4000
UPLOAD_MAX_BYTES=5242880
GRAPH_MAX_NODES=10000
GRAPH_MAX_EDGES=20000
GRAPH_MAX_DEPTH=20
GRAPH_MAX_STRING_LENGTH=10000
SQL_VALIDATION_ENABLED=true

# 语义治理与 EXPLAIN 预检（mysql-only 休眠内核，默认关闭；SQLite 模式不可启用）
SEMANTIC_GOVERNANCE_ENABLED=false
SEMANTIC_MODEL_DIR=semantic_models
SEMANTIC_DATASOURCE=default
SEMANTIC_CONTEXT_MAX_CHARS=2400
SEMANTIC_CONTEXT_MAX_ITEMS=24
SQL_REPAIR_MAX_ATTEMPTS=1
SQL_EXPLAIN_ENABLED=false
SQL_EXPLAIN_TIMEOUT_MS=3000
SQL_EXPLAIN_MAX_ESTIMATED_ROWS=0
# 治理请求 capability 的进程内上限与存活时间
MAX_PREPARED_REQUESTS=256
PREPARED_REQUEST_TTL_SECONDS=120
# 治理历史执行 binding 的存活时间（容量由 HISTORY_MAX_RECORDS 限制）
GOVERNED_HISTORY_BINDING_TTL_SECONDS=900

# 日志配置
LOG_LEVEL=INFO

# 服务器启动脚本配置
STREAMLIT_ADDRESS=0.0.0.0
STREAMLIT_PORT=8501
APP_ENTRY=app.py
PYTHON_DEPS_DIR=python_deps
PIP_CACHE_DIR=.pip_cache
INSTALL_DEPS=1
